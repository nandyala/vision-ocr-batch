# Copy this file to  application-local.properties  (same folder = project root) and fill in.
# application-local.properties is in .gitignore - it never goes to git.
# Values here override src/main/resources/application.properties.

azure.endpoint=https://<your-resource>.cognitiveservices.azure.com/
azure.api-key=<KEY 1 from portal: Document Intelligence > Keys and Endpoint>
# Name of your trained classifier in Document Intelligence Studio.
# Leave EMPTY if you have no classifier: every document is then treated as classify.default-doc-type.
azure.classifier-id=
classify.default-doc-type=AUTO_PAY_AUTH
doctype.auto-pay-auth.model-id=autopay-neural-v2

# Corporate proxy (needed if the job logs "connection timed out" but PowerShell works).
# Find it with PowerShell: [System.Net.WebRequest]::DefaultWebProxy.GetProxy("https://<your-resource>.cognitiveservices.azure.com")
azure.proxy.host=
azure.proxy.port=
# only if the proxy requires a login:
azure.proxy.username=
azure.proxy.password=

# Folder the job scans for PDF/TIFF files (Windows paths: use forward slashes or double backslashes)
input.dir=./data/input
#input.dir=C:/scans/incoming


# ---- Database (Microsoft SQL Server) ----
# The job creates/uses only the schema "ocr" in this database; other schemas and tables are not touched.
db.url=jdbc:sqlserver://<server>:1433;databaseName=<existing db>;encrypt=true;trustServerCertificate=false
db.user=<sql login>
db.password=<password>
# true = create missing ocr.* objects at startup (create-only); false = DBA ran the scripts
db.init=true
