<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE FOR A NEW DOC TYPE - copy to <your-doc-type>.xml in this folder (only *.xml files are loaded).

  Minimum: docType + modelId (+ classifierLabels if you use a classifier).
  Every field the Azure model returns is then stored automatically in DOC_FIELD and
  DOC_JOB.EXTRACTED_JSON under its Azure field name - no Java, schema or XML field list needed.

  Add a FieldMapping only for fields that need a different name, cleanup (normalizers),
  validation, a confidence threshold, or must be present (required).
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="docType.DISPUTE" class="com.visionocr.config.DocTypeConfig">
        <property name="docType" value="DISPUTE"/>
        <property name="description" value="Customer dispute letter / form"/>
        <property name="classifierLabels">
            <list>
                <value>dispute_form</value>
                <value>dispute_letter</value>   <!-- several classifier classes can map to one doc type -->
            </list>
        </property>
        <property name="modelId" value="${doctype.dispute.model-id:dispute-neural-v1}"/>
        <property name="minClassifyConfidence" value="0.80"/>

        <!-- Store all fields returned by the model (default true) -->
        <property name="includeUnmappedFields" value="true"/>
        <!-- Send to REVIEW when any field without rules is below this confidence (0 = off) -->
        <property name="defaultMinConfidence" value="0.0"/>

        <!-- OPTIONAL: columns of the generated view v_doc_dispute (default: the fields listed below).
             Use this to add fields that have no rules, e.g. ones the model returns as-is. -->
        <property name="viewColumns">
            <list>
                <value>accountNumber</value>
                <value>DisputeDate</value>
                <value>DisputedAmount</value>
            </list>
        </property>

        <!-- OPTIONAL: rules for specific fields -->
        <property name="fields">
            <list>
                <bean class="com.visionocr.config.FieldMapping">
                    <property name="azureField" value="AccountNumber"/>
                    <property name="canonicalField" value="accountNumber"/>   <!-- optional rename -->
                    <property name="required" value="true"/>
                    <property name="minConfidence" value="0.85"/>
                    <property name="normalizers"><list><ref bean="norm.digits"/></list></property>
                </bean>
                <bean class="com.visionocr.config.FieldMapping">
                    <property name="azureField" value="DisputeDate"/>
                    <property name="required" value="true"/>
                    <property name="normalizers"><list><ref bean="norm.date"/></list></property>
                    <property name="validators"><list><ref bean="val.isoDate"/></list></property>
                </bean>
                <!-- Table rows are flattened as  Transactions[0].Amount, Transactions[1].Amount ... -->
            </list>
        </property>
    </bean>
</beans>
